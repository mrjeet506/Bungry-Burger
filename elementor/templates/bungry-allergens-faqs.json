                  "settings": {
                    "items": [
                      {
                        "_id": "c20ad4d",
                        "question": "What makes Bungry different?",
                        "answer": "<p>Our signature concept is the distinctive sealed-burger format. Explore the menu to see the current line-up.</p>"
                      },
                      {
                        "_id": "c51ce41",
                        "question": "Where can I find Bungry?",
                        "answer": "<p>We are based in New Zealand. See our address and opening hours on the Find Us page. [CLIENT TO CONFIRM: suburb or city]</p>"
                      },
                      {
                        "_id": "aab3238",
                        "question": "Can I order online?",
                        "answer": "<p>Online ordering is [CLIENT TO CONFIRM: available / not currently available]. When it is available, use the official Order Online link.</p>"
                      },
                      {
                        "_id": "9bf31c7",
                        "question": "Do you have vegetarian options?",
                        "answer": "<p>The proposed menu includes Green Bungry. Confirm the final ingredients and preparation practices before publishing dietary assurances.</p>"
                      },
                      {
                        "_id": "c74d97b",
                        "question": "Where can I check allergens?",
                        "answer": "<p>Please check the current ingredient and allergen information before ordering. If you have a food allergy, contact the team to discuss the specific item and preparation process.</p>"
                      },
                      {
                        "_id": "70efdf2",
                        "question": "Can ingredients or menu items change?",
                        "answer": "<p>Menu availability and ingredients may change. We keep the live menu and allergen information aligned with the current kitchen specification.</p>"
                      }
                    ],
